# Copy to .env and adjust. Real environment variables take precedence over this file.

# CSV file used by save/load and to restore history at startup.
CALC_HISTORY_FILE=data/history.csv

# Save history to CALC_HISTORY_FILE after every change (true/false).
CALC_AUTO_SAVE=true

# Number of significant digits shown in results (0-15).
CALC_PRECISION=6

# Logging level: DEBUG, INFO, WARNING or ERROR. Use INFO to see calculator events.
CALC_LOG_LEVEL=WARNING
